# Copy to .env and adjust. Never commit real secrets or LLM keys.

DATABASE_URL=postgresql+psycopg://appraisal:appraisal@localhost:5432/appraisal
JWT_SECRET=change-me-phase1-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM is unused in Phase 2. Do not set a real key yet.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

MAX_HEAL_ATTEMPTS=3
CORS_ORIGINS=http://localhost:5173

SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=admin-demo
SEED_FACULTY_EMAIL=faculty@demo.local
SEED_FACULTY_PASSWORD=faculty-demo
SEED_HOD_EMAIL=hod@demo.local
SEED_HOD_PASSWORD=hod-demo
SEED_DEAN_EMAIL=dean@demo.local
SEED_DEAN_PASSWORD=dean-demo
SEED_IQAC_EMAIL=iqac@demo.local
SEED_IQAC_PASSWORD=iqac-demo
SEED_COMMITTEE_EMAIL=committee@demo.local
SEED_COMMITTEE_PASSWORD=committee-demo

# Storage backend: "memory" (local dev without MinIO) or "minio"
STORAGE_BACKEND=memory

# MinIO configuration
# Windows local dev: localhost:9000
# Docker internal:   minio:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=faculty-evidence
MINIO_SECURE=false

MAX_UPLOAD_SIZE=10485760
